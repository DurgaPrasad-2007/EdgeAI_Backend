EDGEFLEET_ENV=production
EDGEFLEET_ALLOWED_ORIGINS=https://console.example.in
EDGEFLEET_ALLOWED_HOSTS=api.example.in
DATABASE_URL=postgresql+asyncpg://edgefleet_api:REPLACE_ME@db.example.in:5432/edgefleet?ssl=require
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_FROM_A_SECRET_MANAGER
JWT_ISSUER=edgefleet-api
JWT_AUDIENCE=edgefleet-console
ACCESS_TOKEN_MINUTES=15
AUTH_REQUIRED=true
RATE_LIMIT_PER_MINUTE=240
