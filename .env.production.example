EDGEFLEET_ENV=production
# Frontend URL(s), comma-separated. Do not use the API URL here.
EDGEFLEET_ALLOWED_ORIGINS=https://YOUR-FRONTEND-DOMAIN
# Optional on Render: RENDER_EXTERNAL_HOSTNAME is included automatically.
# Add custom API domain(s) here, comma-separated.
EDGEFLEET_ALLOWED_HOSTS=api.YOUR-DOMAIN
DATABASE_URL=postgresql+asyncpg://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/DATABASE_NAME?ssl=require
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ISSUER=edgefleet-api
JWT_AUDIENCE=edgefleet-console
ACCESS_TOKEN_MINUTES=15
AUTH_REQUIRED=true
RATE_LIMIT_PER_MINUTE=240
