EDGEFLEET_ENV=development
EDGEFLEET_ALLOWED_ORIGINS=http://localhost:3000
EDGEFLEET_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=postgresql+asyncpg://postgres:change-me@127.0.0.1:5432/edgefleet
JWT_SECRET=generate-at-least-32-random-bytes
JWT_ISSUER=edgefleet-api
JWT_AUDIENCE=edgefleet-console
ACCESS_TOKEN_MINUTES=15
AUTH_REQUIRED=true
BOOTSTRAP_ADMIN_EMAIL=admin@edgefleet.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
RATE_LIMIT_PER_MINUTE=240
